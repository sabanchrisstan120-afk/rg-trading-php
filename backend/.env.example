# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rg_trading
DB_USER=root
DB_PASSWORD=

# JWT Secrets
# Replace with real values in production.
JWT_SECRET=development-secret-change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=development-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=30d

# CORS - comma-separated allowed origins
# Use the production frontend origin(s) in production.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3001,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
